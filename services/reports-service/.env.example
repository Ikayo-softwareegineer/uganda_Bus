# Copy this file to .env and change the values.  .env is never committed (see .gitignore).

# Shared secret: the PHP backend must send the same value (REPORTS_SERVICE_KEY there too)
REPORTS_SERVICE_KEY=dev-reports-key

# Where the PHP site keeps its SQLite database (leave empty to use the default:
# ../../php-rebuild/backend/api/data/bus_system.sqlite)
# REPORTS_DB_PATH=/full/path/to/bus_system.sqlite

# Address of this service. 127.0.0.1 = only this computer can reach it.
REPORTS_HOST=127.0.0.1
REPORTS_PORT=5001

# Number of database connections kept open and reused
REPORTS_POOL_SIZE=5

FLASK_SECRET_KEY=change-me
FLASK_DEBUG=0
